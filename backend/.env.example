HMS_ENVIRONMENT=development
HMS_DATABASE_URL=sqlite+aiosqlite:///./tether_dev.sqlite
HMS_SYSTEM_OWNER_USERNAME=
HMS_CORS_ORIGINS=["http://localhost:5173"]

# Docker Compose PostgreSQL 16 settings. Set a local password before starting Compose.
POSTGRES_DB=tether
POSTGRES_USER=tether_app
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# PostgreSQL 16+ target; use after the PostgreSQL service and migrations are ready.
# Replace <user> and <password> with locally managed credentials before enabling.
# HMS_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/tether
